<mvc:View
    controllerName="msu.vendorportal.controller.Docs"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page showHeader="false" class="msuPage">
        <content>
            <VBox class="msuContentHeader">
                <Title text="Documents" level="H2" class="msuPageTitle"/>
                <Text text="POs • ASNs • GRs • Invoices • Payments" class="msuPageSub"/>
            </VBox>

            <IconTabBar id="docsTabs" selectedKey="pos" select="onTabSelect" class="msuTabs" backgroundDesign="Transparent">

                <items>
                    <!-- POs Tab -->
                    <IconTabFilter key="pos" text="POS">
                        <List items="{local>/pos}" class="msuOrderList" showSeparators="None">
                            <CustomListItem type="Active" press="onPOPress" class="msuOrderItem">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                                    <HBox alignItems="Center">
                                        <Avatar initials="{local>initials}" customDisplaySize="44px" backgroundColor="Accent6"/>
                                        <VBox class="sapUiSmallMarginBegin">
                                            <HBox alignItems="Center">
                                                <Title text="{local>id}" level="H5"/>
                                                <Text text="{local>date}" class="msuOrderDate sapUiSmallMarginBegin"/>
                                            </HBox>
                                            <HBox class="sapUiTinyMarginTop">
                                                <ObjectStatus text="{local>product}" state="Warning" inverted="true" class="msuTag"/>
                                            </HBox>
                                            <Text text="{local>qty}" class="msuOrderQty sapUiTinyMarginTop"/>
                                        </VBox>
                                    </HBox>
                                    <ObjectStatus text="{local>status}" state="{= ${local>status} === 'Confirmed' ? 'Success' : 'Information'}" inverted="true" class="msuStatusPill"/>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </IconTabFilter>

                    <!-- ASNs Tab -->
                    <IconTabFilter key="asns" text="ASNS">
                        <List items="{local>/asns}" class="msuOrderList" showSeparators="None">
                            <CustomListItem type="Active" press="onASNPress" class="msuOrderItem">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                                    <VBox>
                                        <Title text="{local>id}" level="H5"/>
                                        <Text text="{local>product} • Ref: {local>poRef}"/>
                                        <Text text="Qty: {local>qty} —" class="msuOrderQty"/>
                                    </VBox>
                                    <ObjectStatus text="{local>status}" state="{= ${local>status} === 'Delivered' ? 'Success' : ${local>status} === 'In Transit' ? 'Information' : 'Warning'}" inverted="true" class="msuStatusPill"/>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </IconTabFilter>

                    <IconTabFilter key="grs" text="GRS">
                        <MessageStrip text="No goods receipts yet." type="Information" showIcon="true" class="sapUiMediumMargin"/>
                    </IconTabFilter>

                    <IconTabFilter key="invoices" text="INVOICES">
                        <MessageStrip text="No invoices yet." type="Information" showIcon="true" class="sapUiMediumMargin"/>
                    </IconTabFilter>

                    <IconTabFilter key="payments" text="PAYMENTS">
                        <MessageStrip text="No payments yet." type="Information" showIcon="true" class="sapUiMediumMargin"/>
                    </IconTabFilter>
                </items>
            </IconTabBar>

        </content>
    </Page>
</mvc:View>